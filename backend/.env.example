NODE_ENV=development
PORT=3000

# Supabase — AUTH ONLY (Railway hosts everything else)
# Database has moved to Railway Postgres; Supabase now only runs Auth.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional — enables local JWT verification in auth (faster per request).
# Legacy JWT secret from Supabase → Settings → API.
SUPABASE_JWT_SECRET=your-jwt-secret

# Prisma — Railway Postgres
# Runtime: reference the private internal URL (fast, no egress):
#   railway variables set DATABASE_URL ${{Postgres.DATABASE_URL}}
# The schema is pushed at container start (see railway.json), so the
# runtime URL is used for migrations too — no public URL needed.
DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway
DIRECT_DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway

# Subscriptions
SUBSCRIPTION_TOKEN_SECRET=change-me-to-a-random-64-char-string

# Railway Redis — reference the private internal URL:
#   railway variables set REDIS_URL ${{Redis.REDIS_URL}}
REDIS_URL=redis://redis.railway.internal:6379

# Paystack
PAYSTACK_SECRET_KEY=sk_live_xxxxx

# Agora
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate

# Firebase Admin
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# Resend
RESEND_API_KEY=re_xxxxx
FROM_EMAIL=noreply@noorcompanion.com

# Sentry
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Website
WEBSITE_URL=https://noorcompanion.netlify.app
